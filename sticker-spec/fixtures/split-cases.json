{
  "note": "split（位置即语义）用例：input 是整条正文，expect 是段序列——\"text:<内容>\" 或 \"sticker:<池titles排序|连接>\"。断言的是池不是选中项（selector 的随机性不进 fixtures）。文本首尾避免空白（无命中时两端 strip/原样行为不同，那属实现自由，README 有记）。",
  "cases": [
    {
      "name": "position_is_semantics",
      "input": "A\n（😢）\nB\n（😏）",
      "expect": [
        "text:A",
        "sticker:CRY_A",
        "text:B",
        "sticker:SMUG"
      ]
    },
    {
      "name": "stage_direction_untouched",
      "input": "（挑眉）你好（点头）",
      "expect": [
        "text:（挑眉）你好（点头）"
      ]
    },
    {
      "name": "inline_code_masked",
      "input": "语法是 `（😢）` 这样",
      "expect": [
        "text:语法是 `（😢）` 这样"
      ]
    },
    {
      "name": "double_backtick_code_masked",
      "input": "``（😢）``",
      "note": "成对等长的反引号串是一个代码跨度，中间的表情要遮住——不是把边界两个反引号各当成一段空代码、漏了中间（spec 裁决：按 Markdown 边界）。",
      "expect": [
        "text:``（😢）``"
      ]
    },
    {
      "name": "quad_backtick_code_masked",
      "input": "````（😢）````",
      "expect": [
        "text:````（😢）````"
      ]
    },
    {
      "name": "fence_masked",
      "input": "```\n（😢）\n```\n好",
      "expect": [
        "text:```\n（😢）\n```\n好"
      ]
    },
    {
      "name": "tilde_fence_masked",
      "input": "~~~\n（😢）\n~~~\n好",
      "note": "波浪线围栏也照 Markdown 边界遮。",
      "expect": [
        "text:~~~\n（😢）\n~~~\n好"
      ]
    },
    {
      "name": "unclosed_fence_masks_to_eof",
      "input": "```\n（😢）",
      "note": "未闭合的围栏按 Markdown 吃到文末，里面的表情不喷贴纸。",
      "expect": [
        "text:```\n（😢）"
      ]
    },
    {
      "name": "unknown_left_verbatim",
      "input": "好（🦄）走",
      "expect": [
        "text:好（🦄）走"
      ]
    },
    {
      "name": "halfwidth_parens",
      "input": "来 (😏)",
      "expect": [
        "text:来",
        "sticker:SMUG"
      ]
    },
    {
      "name": "sticker_only_message",
      "input": "（😢）",
      "expect": [
        "sticker:CRY_A"
      ]
    },
    {
      "name": "max_three_fourth_left",
      "input": "（😢）a（😏）b（🧑‍💻）c（😴）",
      "expect": [
        "sticker:CRY_A",
        "text:a",
        "sticker:SMUG",
        "text:b",
        "sticker:CODER",
        "text:c（😴）"
      ]
    },
    {
      "name": "mid_sentence_splits",
      "input": "好啊（😏）现在就去",
      "expect": [
        "text:好啊",
        "sticker:SMUG",
        "text:现在就去"
      ]
    },
    {
      "name": "empty_intersection_left_verbatim",
      "input": "（🥺💻）",
      "expect": [
        "text:（🥺💻）"
      ]
    },
    {
      "name": "cross_hit_in_text",
      "input": "在看书\n（📖😭）",
      "expect": [
        "text:在看书",
        "sticker:CRY_BOOK"
      ]
    },
    {
      "name": "alias_pool_merged_in_split",
      "input": "嗯\n（😭）",
      "expect": [
        "text:嗯",
        "sticker:CRY_A|CRY_BOOK"
      ]
    },
    {
      "name": "long_marker_17_to_32_codepoints",
      "input": "哈哈\n（🧑‍💻🧑‍💻🧑‍💻🧑‍💻🧑‍💻🧑‍💻）",
      "expect": [
        "text:哈哈",
        "sticker:CODER"
      ]
    },
    {
      "name": "marker_within_16_codepoints_both_accept",
      "input": "哈哈\n（🧑‍💻🧑‍💻🧑‍💻🧑‍💻）",
      "expect": [
        "text:哈哈",
        "sticker:CODER"
      ]
    },
    {
      "name": "longer_closing_fence_then_marker",
      "input": "```\ncode\n````\n好（😢）",
      "note": "CommonMark §4.5：闭合围栏可比起始更长（同字符、长度≥起始）。较长的 ```` 应闭合 ``` 围栏，其后的标记不在代码内、照常喷贴纸——不能把较长闭合当未闭合、吃到文末遮住后文。",
      "expect": [
        "text:```\ncode\n````\n好",
        "sticker:CRY_A"
      ]
    },
    {
      "name": "longer_closing_fence_masks_inside",
      "input": "```\n（😢）\n````\n尾巴",
      "note": "同上：块内的标记仍被遮住（不发），整段是纯文本。",
      "expect": [
        "text:```\n（😢）\n````\n尾巴"
      ]
    },
    {
      "name": "inline_triple_backtick_then_marker",
      "input": "```x``` 好（😢）",
      "note": "反引号起始围栏的 info string 不得含反引号（CommonMark §4.5）——```x``` 是行内代码不是块围栏起始，只遮代码本身，后面正文照常喷贴纸。",
      "expect": [
        "text:```x``` 好",
        "sticker:CRY_A"
      ]
    }
  ]
}
